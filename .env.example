# Copy to .env (git-ignored) or export these. All are optional except the key.
# Provider: anthropic (Claude API), bedrock (Amazon Bedrock) or nim (NVIDIA NIM / OpenAI-compatible)
REWIND_PROVIDER=nim

# nim only: OpenAI-compatible endpoint (default https://integrate.api.nvidia.com/v1)
REWIND_BASE_URL=https://integrate.api.nvidia.com/v1

# Key for the provider: a Console key (sk-ant-api...), a Bedrock API key, or an NVIDIA key (nvapi-...).
# Overrides ANTHROPIC_API_KEY / AWS_BEARER_TOKEN_BEDROCK from the shell.
REWIND_API_KEY=your-api-key-here

# Model to use
REWIND_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
REWIND_MAX_OUTPUT_TOKENS=4096
REWIND_SUMMARY_MAX_TOKENS=1024
REWIND_CONTEXT_LIMIT=8000

# Bedrock only: key (API key) or aws (aws login / profile credentials)
# REWIND_BEDROCK_AUTH=key
# Bedrock only; defaults to AWS_REGION or ~/.aws/config
# REWIND_AWS_REGION=

REWIND_KEEP_RECENT_MESSAGES=4
REWIND_RECALL_MIN_COVERAGE=0.5
REWIND_PROMPT_CACHING=1
REWIND_REFUSAL_FALLBACKS=1
REWIND_STORE=jsonl
REWIND_DATA_DIR=data
# MCP server only: keeps projects apart in a shared archive
REWIND_MCP_SESSION=mcp

